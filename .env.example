# HydroSurge AI - Module 4 Environment Configuration
# Status: VERIFIED 🟢

# Provider Mode Selection
# Options:
#   - mock (default): Deterministic replay from demo/replay/scenario.json
#   - rainfall_live: Attempt R&D-1 Rainfall ML model, fallback to mock on failure
#   - inundation_live: Attempt R&D-2 Inundation ML model, fallback to mock on failure
#   - live: Attempt all live models, fallback to mock on failure
PROVIDER_MODE=mock

# Server Port
API_PORT=8000

# --- Placeholders for future real R&D-1 & R&D-2 provider integration ---
# RAINFALL_MODEL_PATH=./models/dgmr_chennai.pt
# INUNDATION_MODEL_PATH=./models/flood_dem_risk.tif
# MOSDAC_API_KEY=
# IMD_RADAR_ENDPOINT=