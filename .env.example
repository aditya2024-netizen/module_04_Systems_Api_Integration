# HydroSurge AI — Module 4 Integration Environment Configuration
# Status: VERIFIED 🟢

# Provider Mode Selection
# Options:
#   - mock (default): Deterministic replay from demo/replay/scenario.json
#   - rainfall_live: Attempt MOD_1 Rainfall ML model, fallback to mock on failure
#   - inundation_live: Attempt MOD_2 Inundation ML model, fallback to mock on failure
#   - live: Attempt all live models, fallback to mock on failure
PROVIDER_MODE=mock

# Server Port
API_PORT=8000

# CORS Allowed Origins (comma-separated or * for all)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Dashboard Public API URL (consumed by dashboard/app/lib/api.js)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Placeholders for future real MOD_1 & MOD_2 provider integration ---
# RAINFALL_MODEL_PATH=./models/dgmr_chennai.pt
# INUNDATION_MODEL_PATH=./models/flood_dem_risk.tif
# MOSDAC_API_KEY=
# IMD_RADAR_ENDPOINT=